# Copia in .env per lavorare in locale. MAI caricare il file .env su GitHub.
DATABASE_URL=postgresql://localhost/dealfinder
SECRET_KEY=                 # stringa casuale lunga: firma gli accessi
PLATE_SALT=                 # stringa casuale lunga: cifra le targhe
ADMIN_EMAIL=                # primo amministratore (creato all'avvio se non esiste)
ADMIN_PASSWORD=

# AI (Claude API)
ANTHROPIC_API_KEY=
AI_MODEL_FAST=claude-haiku-5-5        # filtro veloce, testo, identificazione
AI_MODEL_DEEP=claude-sonnet-5-5       # foto approfondite, agente ricambi
AI_WEB_SEARCH_TOOL=web_search_20250305  # versione dello strumento di ricerca web

# Scraper esterno di Facebook Marketplace (es. Apify)
META_PROVIDER_TOKEN=
META_ACTOR_ID=
META_PROVIDER_INPUT=        # JSON con i parametri di ricerca dello scraper scelto

# Facoltativi
SCRAPER_PROXY=              # proxy per la raccolta, se un sito blocca i server cloud
PLATE_LOOKUP_URL=           # servizio dati veicolo da targa, es. https://api.esempio.it/v1/{plate}
PLATE_LOOKUP_KEY=
PROCESS_BATCH=400           # annunci per giro di filtro
DEEP_BATCH=60               # candidati per giro di approfondimento
