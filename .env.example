# Copia in .env per lavorare in locale. MAI caricare il file .env su GitHub.
DATABASE_URL=postgresql://localhost/dealfinder
ANTHROPIC_API_KEY=
# Scraper esterno di Facebook Marketplace (es. Apify)
META_PROVIDER_TOKEN=
META_ACTOR_ID=
# Proxy facoltativo per la raccolta, se un sito blocca i server cloud
SCRAPER_PROXY=
# Sale per l'hash delle targhe (stringa casuale lunga)
PLATE_SALT=
